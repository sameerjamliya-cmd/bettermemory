# --- Required ---------------------------------------------------------------

# OpenAI API key. Used for embeddings (text-embedding-3-small) and for the
# extraction call (gpt-4o-mini), including the multimodal call when an image is
# passed to add(). A single key covers all three.
OPENAI_API_KEY=

# Qdrant endpoint. `docker compose up -d` serves this locally on 6333.
QDRANT_URL=http://localhost:6333

# Shared secret for the REST API. Every request to /api/memory/* must send
#   Authorization: Bearer <API_KEY>
# Generate a real one — do not ship this placeholder:
#   openssl rand -hex 32
# The routes fail closed: if API_KEY is unset the API returns 500 rather than
# serving unauthenticated requests.
API_KEY=

# --- Optional ---------------------------------------------------------------

# Extraction model. Defaults to gpt-4o-mini when unset.
# gpt-4o was measured as better on multi-dimension supersession and paraphrase
# dedup, at roughly 10x the per-token cost. The default deliberately stays on
# gpt-4o-mini; see "Known limitations" in the README.
# EXTRACTION_MODEL=

# Attempts per scenario for `npm run test:extraction`. Defaults to 6.
# ATTEMPTS=

# NOTE: there is no env var for choosing a vector store or LLM provider. The
# provider seam (lib/providers/) is wired in code, in lib/memory.ts, on purpose —
# see "Known limitations".
